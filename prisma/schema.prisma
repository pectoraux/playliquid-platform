// PlayLiquid Experience Kernel v0.1 — Prisma schema
// The kernel persists: registered extensions, compiled bundles, sessions,
// the double-entry ledger, token balances/events, and telemetry/genomes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Extensions & Bundles ───────────────────────────────────────────────────

model ExtensionRecord {
  id              String   @id // matches manifest.id, e.g. "pl.physics"
  slug            String   @unique
  name            String
  description     String
  creatorId       String   @default("platform")
  creatorName     String   @default("PlayLiquid")
  author          String   // legacy field, same as creatorName
  category        String   // PHYSICS | MECHANIC | ECONOMY | SOCIAL | AI | RENDER
  kind            String   // native-dsl | html5 | external | ai-agent
  trustLevel      String
  determinism     String
  manifestJson    String   // full manifest as JSON
  // ── ADR-001: Canonical extension entity ─────────────────────────────
  version         Int      @default(1)
  parentExtensionId String? // fork lineage
  icon            String   @default("📦")
  tagsJson        String   @default("[]")
  // Pricing & royalties
  priceXof        Int      @default(0)  // 0 = free
  royaltyBps      Int      @default(0)  // BPS of creator's revenue share
  // Reputation
  qualityScore    Int      @default(50)
  performanceScore Int     @default(50)
  innovationScore Int      @default(50)
  fairnessScore   Int      @default(50)
  adoptionScore   Int      @default(0)
  // Stats
  installCount    Int      @default(0)
  forkCount       Int      @default(0)
  rating          Float    @default(5.0)
  ratingCount     Int      @default(0)
  totalRevenueXof Int      @default(0)
  // Lifecycle
  status          String   @default("PUBLISHED") // DRAFT | PUBLISHED | DEPRECATED | REMOVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances       BundleInstance[]
  installations   ExtensionInstallationRecord[]
}

model BundleRecord {
  contentHash   String   @id // FNV-1a fingerprint from compiler
  experienceId  String
  type          String // GAME | SPARK
  name          String?
  bundleJson    String // full bundle spec as JSON
  deterministic Boolean
  createdAt     DateTime @default(now())

  instances    BundleInstance[]
  sessions     PlaySession[]
  genome       ExperienceGenomeRecord?
}

model BundleInstance {
  id            String   @id @default(cuid())
  bundleHash    String
  instanceId    String // local id within bundle
  extensionId   String
  role          String?
  configJson    String  @default("{}")
  bundle        BundleRecord   @relation(fields: [bundleHash], references: [contentHash])
  extension     ExtensionRecord @relation(fields: [extensionId], references: [id])
}

// ─── Sessions ──────────────────────────────────────────────────────────────

model PlaySession {
  id            String   @id @default(cuid())
  experienceId  String
  bundleHash    String?
  mode          String // PREVIEW | EARN
  seed          String
  userId        String?
  status        String  @default("ACTIVE") // ACTIVE | ENDED | SUSPENDED
  tickCount     Int      @default(0)
  actionCount   Int      @default(0)
  score         Int      @default(0)
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  // ── ADR-008: Competitive session fields ──────────────────────────────
  competitiveMode  Boolean  @default(false)
  minutePurchaseId String?  // links to MinutePurchaseRecord
  timerStartedAt   DateTime?
  timerElapsedMs   Int      @default(0)
  attempts         Int      @default(1)  // restarts within purchased time
  highestScore     Int      @default(0)  // highest across attempts

  bundle        BundleRecord? @relation(fields: [bundleHash], references: [contentHash])
  tokenEvents   TokenEventRecord[]
  tokenBalances TokenBalanceRecord[]
  telemetry     ExperienceEventRecord?
  player        PlayerProfile? @relation(fields: [userId], references: [userId])
}

// ─── Liquid Ledger (double-entry) ──────────────────────────────────────────

model LedgerAccountRecord {
  id        String   @id // e.g. "player:wallet:user_1"
  kind      String
  balance   BigInt   @default(0) // micro-Liquid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries LedgerEntryRecord[]
}

model LedgerTxRecord {
  id        String   @id @default(cuid())
  memo      String?
  createdAt DateTime @default(now())
  entries   LedgerEntryRecord[]
}

model LedgerEntryRecord {
  id        String   @id @default(cuid())
  txId      String
  account   String
  debit     BigInt   @default(0)
  credit    BigInt   @default(0)
  memo      String?
  lineNo    Int
  createdAt DateTime @default(now())

  tx        LedgerTxRecord     @relation(fields: [txId], references: [id])
  accountRef LedgerAccountRecord @relation(fields: [account], references: [id])
}

// ─── Extension Tokens ──────────────────────────────────────────────────────

model TokenBalanceRecord {
  id        String   @id @default(cuid())
  sessionId String
  symbol    String
  balance   Int      @default(0)
  scope     String   @default("session")
  session   PlaySession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, symbol])
}

model TokenEventRecord {
  id        String   @id @default(cuid())
  sessionId String
  kind      String   // EMIT | CONSUME | SETTLE | REJECT
  symbol    String
  amount    Int
  instance  String?
  reason    String?
  tick      Int?
  createdAt DateTime @default(now())
  session   PlaySession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

// ─── Telemetry & Genome ────────────────────────────────────────────────────

model ExperienceEventRecord {
  id                 String   @id @default(cuid())
  experienceId       String
  sessionId          String   @unique
  bundleHash         String?
  tickCount          Int
  sessionDurationMs  Int
  actions            Int
  completion         Boolean
  score              Int?
  tokensEmittedJson  String   @default("{}")
  tokensConsumedJson String   @default("{}")
  extensionsJson     String   @default("[]")
  createdAt          DateTime @default(now())

  session            PlaySession @relation(fields: [sessionId], references: [id])
}

model ExperienceGenomeRecord {
  id              String   @id @default(cuid())
  experienceId    String
  bundleHash      String   @unique
  extensionsJson  String
  categoriesJson  String
  mechanicsJson   String
  compositionDepth Int
  hasEconomy      Boolean
  hasAI           Boolean
  tokenCount      Int
  computedAt      DateTime @default(now())

  bundle          BundleRecord @relation(fields: [bundleHash], references: [contentHash])
}

// ─── Studio: Creators & Published Experiences ──────────────────────────────

model CreatorRecord {
  id            String   @id @default(cuid())
  handle        String   @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  followers     Int      @default(0)
  totalLiquid   Int      @default(0)  // micro-Liquid earned
  playerHours   Int      @default(0)  // total play time in seconds
  // ── Identity Layer v0.45 ──────────────────────────────────────────────
  creatorLevel  Int      @default(1)
  creatorXP     Int      @default(0)
  creatorGenomeJson String @default("{}")  // { strategy: 94, economy: 88, social: 71 }
  reputationJson String  @default("{}")    // { quality: 94, innovation: 87, fairness: 98 }
  createdAt     DateTime @default(now())

  experiences   ExperienceRecord[]
}

model ExperienceRecord {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  description         String
  creatorId           String
  bundleHash          String?
  parentExperienceId  String?  // fork lineage
  intentJson          String   @default("{}")  // ExperienceIntent
  genomeJson          String?  // computed at publish
  status              String   @default("DRAFT")  // DRAFT | PUBLISHED | ARCHIVED
  playCount           Int      @default(0)
  forkCount           Int      @default(0)
  likeCount           Int      @default(0)
  // ── ADR-003: Spark format (presentation, not content type) ──────────
  format              String   @default("standard")  // spark | standard
  // ── ADR-008: Competitive pricing configuration ──────────────────────
  pricePerMinuteXof   Int      @default(0)  // 0 = free casual play
  minMinutesPurchase  Int      @default(1)
  maxMinutesPurchase  Int      @default(60)
  competitiveEligible Boolean  @default(false)
  createdAt           DateTime @default(now())
  publishedAt         DateTime?

  creator             CreatorRecord @relation(fields: [creatorId], references: [id])
  parent              ExperienceRecord? @relation("ForkTree", fields: [parentExperienceId], references: [id])
  forks               ExperienceRecord[] @relation("ForkTree")
}

// ─── World Engine v0.2 ─────────────────────────────────────────────────────

model PlayerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  displayName         String
  avatarUrl           String?
  bio                 String?
  playerGenomeJson    String   @default("{}")  // favorite genres, emotions, skill
  creatorScore        Int      @default(0)
  playerScore         Int      @default(0)
  collaborationScore  Int      @default(0)
  trustScore          Int      @default(50)    // 0-100
  achievementsJson    String   @default("[]")
  followersJson       String   @default("[]")  // userIds of followers
  followingJson       String   @default("[]")  // userIds being followed
  friendsJson         String   @default("[]")  // bidirectional friend userIds
  liquidBalance       Int      @default(0)     // micro-Liquid earned as player
  // ── Identity Layer v0.45 ──────────────────────────────────────────────
  playerLevel         Int      @default(1)
  playerXP            Int      @default(0)
  skillsJson          String   @default("{}")  // { farming: 82, trading: 74, ... }
  reputationJson      String   @default("{}")  // { builder: 90, trader: 85, ... }
  inventoryJson       String   @default("[]")  // array of InventoryItem
  worldPassportJson   String   @default("{}")  // { visited: [], citizenships: [] }
  companionStateJson  String   @default("{}")  // AI companion memory + personality
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  follows             ExperienceFollow[]
  comments            ExperienceComment[]
  sessions            PlaySession[]
  activityFeed        ActivityFeedRecord[]
  ratings             ExperienceRatingRecord[]
}

model ExperienceFollow {
  id            String   @id @default(cuid())
  userId        String
  experienceId  String
  createdAt     DateTime @default(now())

  player        PlayerProfile @relation(fields: [userId], references: [userId])
  @@unique([userId, experienceId])
}

model ExperienceComment {
  id            String   @id @default(cuid())
  experienceId  String
  userId        String
  body          String
  createdAt     DateTime @default(now())

  player        PlayerProfile @relation(fields: [userId], references: [userId])
}

model ExperienceMetrics {
  id                String   @id @default(cuid())
  experienceId      String   @unique
  totalSessions     Int      @default(0)
  totalPlayTimeMs   Int      @default(0)
  completionRate    Float    @default(0)
  averageScore      Float    @default(0)
  averageDropOffMs  Int      @default(0)
  retention1d       Float    @default(0)
  retention7d       Float    @default(0)
  frustrationEvents Int      @default(0)
  achievementEvents Int      @default(0)
  surpriseEvents    Int      @default(0)
  socialMoments     Int      @default(0)
  tokensEarned      Int      @default(0)
  tokensSpent       Int      @default(0)
  marketActions     Int      @default(0)
  forks             Int      @default(0)
  shares            Int      @default(0)
  updatedAt         DateTime @updatedAt
}

// ─── Phase 20: Experience Evolution Operating System ───────────────────────
// Status lifecycle: DISCOVERED → PROPOSED → CREATOR_REVIEW → EXPERIMENTING
//                    → APPROVED | REJECTED | ROLLED_BACK
model EvolutionProposal {
  id              String   @id @default(cuid())
  experienceId    String
  analysisJson    String   @default("{}")  // AI reasoning, patterns found
  proposedChangesJson String @default("{}")  // what to change in the graph
  predictedLift   Float    @default(0)     // e.g. 0.18 = +18% retention
  newBundleJson   String?  // the proposed fork bundle
  // ── Phase 20.2: structured proposal fields ──────────────────────────
  problem         String?  // "78% of players quit after weather event."
  evidence        String?  // "Players who encounter storm mechanic have 45% lower completion."
  affectedExtensionsJson String @default("[]")  // ["pl.weather", "pl.movement"]
  graphChangesJson String  @default("{}")  // structured mutation description
  expectedImpact  String?  // "+12% completion"
  confidenceScore Float    @default(0)     // 0.0 - 1.0
  mutationId      String?  // link to ExperienceMutationRecord when created
  // PENDING kept for backward compat; new flow uses the richer lifecycle.
  status          String   @default("DISCOVERED")  // DISCOVERED | PROPOSED | CREATOR_REVIEW | EXPERIMENTING | APPROVED | REJECTED | ROLLED_BACK | PENDING | APPLIED
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  @@index([experienceId])
  @@index([status])
}

// ─── Phase 20.3: Graph Mutation System ─────────────────────────────────────
// The AI never edits experiences directly. It creates graph mutations that
// must be creator-approved before they touch production.
model ExperienceMutationRecord {
  id              String   @id @default(cuid())
  experienceId    String
  proposalId      String?  // originating evolution proposal
  mutationType    String   // ADD_EXTENSION | REMOVE_EXTENSION | UPDATE_CONFIG | REWIRE_CONNECTION | CHANGE_ECONOMY
  beforeGraphJson String   // ExperienceBundle snapshot before mutation
  afterGraphJson  String   // ExperienceBundle snapshot after mutation
  creatorApproved Boolean  @default(false)
  status          String   @default("PENDING")  // PENDING | APPROVED | APPLIED | REJECTED | ROLLED_BACK
  appliedExperienceId String?  // the experience the mutation was applied to
  createdAt       DateTime @default(now())
  appliedAt       DateTime?

  @@index([experienceId])
  @@index([proposalId])
}

// ─── Phase 20.6: Player Feedback Intelligence ──────────────────────────────
model ExperienceFeedbackRecord {
  id              String   @id @default(cuid())
  experienceId    String
  playerId        String?
  sessionId       String?
  type            String   // FUN | CONFUSING | TOO_HARD | BUG | SUGGESTION
  funScore        Float    @default(0)     // 0.0 - 5.0
  difficultyScore Float    @default(0)     // 0.0 - 5.0
  emotionScore    Float    @default(0)     // 0.0 - 5.0
  comment         String?
  clusterLabel    String?  // assigned by AI clustering ("Players love speed mechanics")
  createdAt       DateTime @default(now())

  @@index([experienceId])
  @@index([type])
}

// ─── Phase 20.4: Evolution Sandbox / A-B runs ──────────────────────────────
// Records the result of running variantA (control) vs variantB (mutated)
// through the simulation lab. The winner is selected by the experiment metric.
model EvolutionRunRecord {
  id              String   @id @default(cuid())
  experienceId    String
  mutationId      String?  // the mutation being tested
  simulationId    String?  // link to SimulationRun (variant B)
  variantA        String   // label, e.g. "Current v1.2"
  variantB        String   // label, e.g. "Weather v2 (stormChance 0.14)"
  winner          String?  // "A" | "B" | "TIE" | null
  metricsJson     String   @default("{}")  // { A: {...}, B: {...}, delta: {...} }
  status          String   @default("RUNNING")  // RUNNING | COMPLETED | FAILED
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([experienceId])
  @@index([mutationId])
}

model SimulationRun {
  id              String   @id @default(cuid())
  experienceId    String
  playerCount     Int
  variantLabel    String?  // "A", "B", "C"
  variantConfigJson String @default("{}")
  metricsJson     String   @default("{}")
  status          String   @default("RUNNING")  // RUNNING | COMPLETED
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

model RoyaltyNode {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  sharesJson      String   @default("[]")  // [{creatorId, shareBps, role}]
  updatedAt       DateTime @updatedAt
}

// ─── Civilization Engine v0.3 ──────────────────────────────────────────────

model WorldRecord {
  id              String   @id @default(cuid())
  name            String
  description     String
  experienceId    String
  creatorId       String
  status          String   @default("DORMANT")  // DORMANT | ACTIVE | PAUSED | ENDED
  tickCount       Int      @default(0)
  population      Int      @default(0)
  worldGenomeJson String   @default("{}")
  macroStateJson  String   @default("{}")
  createdAt       DateTime @default(now())
  lastTickAt      DateTime?

  entities        WorldEntityRecord[]
  events          WorldEventRecord[]
  assets          AssetRecord[]
  ticks           WorldTickRecord[]
  history         WorldHistoryRecord[]
  relationships   RelationshipRecord[]
}

model WorldEntityRecord {
  id              String   @id @default(cuid())
  worldId         String
  name            String
  type            String   // CITIZEN | MERCHANT | BUILDER | EXPLORER | COMPETITOR | ORGANIZATION | RESOURCE_NODE | PLAYER
  agentGenomeJson String   @default("{}")
  wealth          Int      @default(0)   // micro-Liquid
  resourcesJson   String   @default("{}")
  reputation      Int      @default(0)
  relationshipsJson String @default("{}")
  memoryJson      String   @default("[]")
  lastDecisionTick Int     @default(0)
  alive           Boolean  @default(true)
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
  ownedAssets     AssetRecord[]
}

model RelationshipRecord {
  id              String   @id @default(cuid())
  worldId         String
  fromEntityId    String
  toEntityId      String
  type            String   // owns | trades | competes | collaborates | trusts | fears | allied | rival
  strength        Int      @default(50)
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

model WorldEventRecord {
  id              String   @id @default(cuid())
  worldId         String
  name            String
  description     String
  type            String   // economic | social | environmental | competitive | crisis | discovery
  tick            Int
  effectsJson     String   @default("{}")
  rewardsJson     String   @default("{}")
  storyText       String   @default("")
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

model AssetRecord {
  id              String   @id @default(cuid())
  worldId         String
  name            String
  type            String   // land | building | business | item | infrastructure
  ownerId         String?
  purchasePrice   Int      @default(0)
  generationRateJson String @default("{}")
  forSale         Boolean  @default(false)
  askingPrice     Int?
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
  owner           WorldEntityRecord? @relation(fields: [ownerId], references: [id])
}

model WorldTickRecord {
  id              String   @id @default(cuid())
  worldId         String
  tick            Int
  stateSnapshotJson String @default("{}")
  eventsJson      String   @default("[]")
  decisionsCount  Int      @default(0)
  timestamp       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

model WorldHistoryRecord {
  id              String   @id @default(cuid())
  worldId         String
  tick            Int
  type            String   // founding | event | milestone | crisis | discovery | social | economic
  title           String
  narrative       String
  timestamp       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

// ─── Universe v0.4 — Consumer Platform Layer ───────────────────────────────

model ActivityFeedRecord {
  id              String   @id @default(cuid())
  userId          String   // who performed the action
  type            String   // played | forked | published | followed | earned | evolved | rated | joined
  targetType      String   // experience | creator | world | spark
  targetId        String?
  targetName      String?
  detail          String?  // extra context
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  player          PlayerProfile @relation(fields: [userId], references: [userId])
}

model ExperienceRatingRecord {
  id              String   @id @default(cuid())
  experienceId    String
  userId          String
  overallScore    Int      @default(50)  // 0-100 reputation score
  completionScore Int      @default(50)
  returnScore     Int      @default(50)
  socialScore     Int      @default(50)
  emotionScore    Int      @default(50)
  economyScore    Int      @default(50)
  reviewText      String?
  createdAt       DateTime @default(now())

  player          PlayerProfile @relation(fields: [userId], references: [userId])
  @@unique([experienceId, userId])
}

model FriendRequestRecord {
  id              String   @id @default(cuid())
  fromUserId      String
  toUserId        String
  status          String   @default("PENDING")  // PENDING | ACCEPTED | REJECTED
  createdAt       DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

// ─── Identity Layer v0.45 — Persistent Identity ───────────────────────────

model AchievementRecord {
  id              String   @id @default(cuid())
  userId          String
  achievementId   String   // e.g. "first-play", "top-trader", "world-founder"
  title           String
  description     String
  icon            String   @default("🏆")
  category        String   // play | create | social | economy | exploration | mastery
  rarity          String   @default("common")  // common | rare | epic | legendary
  xpReward        Int      @default(10)
  metadataJson    String   @default("{}")
  earnedAt        DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model InventoryItemRecord {
  id              String   @id @default(cuid())
  userId          String
  itemId          String   // unique item identifier
  name            String
  description     String
  icon            String   @default("📦")
  type            String   // asset | reward | achievement | resource | cosmetic | tool
  rarity          String   @default("common")  // common | rare | epic | legendary | mythic
  quantity        Int      @default(1)
  worldId         String?  // which world it came from (null = universal)
  metadataJson    String   @default("{}")
  acquiredAt      DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

model WorldVisitRecord {
  id              String   @id @default(cuid())
  userId          String
  worldId         String
  worldName       String
  visitCount      Int      @default(1)
  firstVisitAt    DateTime @default(now())
  lastVisitAt     DateTime @default(now())
  citizenshipStatus String @default("visitor")  // visitor | resident | citizen | leader
  metadataJson    String   @default("{}")

  @@unique([userId, worldId])
  @@index([userId])
}

model CompanionMessageRecord {
  id              String   @id @default(cuid())
  userId          String
  role            String   // user | companion
  content         String
  messageType     String   @default("chat")  // chat | suggestion | alert | insight
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ─── v0.45 Consumer Reality Layer — The YouTube Moment ─────────────────────

model PlayGraphRecord {
  id              String   @id @default(cuid())
  userId          String
  experienceId    String
  interaction     String   // liked | played | abandoned | mastered | shared | forked | watched | competed | saved | rated
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([experienceId])
  @@index([userId, interaction])
}

model SavedSparkRecord {
  id              String   @id @default(cuid())
  userId          String
  experienceId    String
  createdAt       DateTime @default(now())

  @@unique([userId, experienceId])
  @@index([userId])
}

model ChallengeRecord {
  id              String   @id @default(cuid())
  experienceId    String
  creatorId       String
  title           String
  description     String
  type            String   @default("score")  // score | speed | survival | creative | social
  rewardLiquid    Int      @default(0)  // micro-Liquid prize pool
  targetScore     Int?
  durationHours   Int      @default(24)
  participantsJson String  @default("[]")  // userIds
  entriesJson     String   @default("[]")  // [{userId, score, at}]
  status          String   @default("ACTIVE")  // ACTIVE | COMPLETED | CANCELLED
  startsAt        DateTime @default(now())
  endsAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([experienceId])
}

model LeaderboardEntryRecord {
  id              String   @id @default(cuid())
  experienceId    String
  userId          String
  displayName     String
  score           Int
  rank            Int?
  sessionId       String?
  achievedAt      DateTime @default(now())

  @@unique([experienceId, userId])
  @@index([experienceId, score])
}

model LiveSessionRecord {
  id              String   @id @default(cuid())
  experienceId    String
  experienceName  String
  userId          String
  displayName     String
  sessionId       String
  viewerCount     Int      @default(0)
  status          String   @default("LIVE")  // LIVE | ENDED
  peakViewers     Int      @default(0)
  startedAt       DateTime @default(now())
  endedAt         DateTime?
}

model CreatorChannelRecord {
  id              String   @id @default(cuid())
  creatorId       String   @unique
  channelName     String
  tagline         String?
  bannerUrl       String?
  totalViews      Int      @default(0)
  totalPlayTimeMs Int      @default(0)
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── v0.46 Social Universe — Retention & Reality Layer ─────────────────────

model CollectionRecord {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  isPublic        Boolean  @default(true)
  coverEmoji      String   @default("📁")
  itemsJson       String   @default("[]")  // array of experienceIds
  followerCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model ReplayRecord {
  id              String   @id @default(cuid())
  sessionId       String
  experienceId    String
  experienceName  String
  userId          String
  displayName     String
  score           Int
  durationMs      Int
  highlightType   String?  // comeback | world-record | upset | clutch | speedrun
  highlightLabel  String?  // "Impossible comeback" etc.
  isPublic        Boolean  @default(true)
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  eventLogJson    String   @default("[]")  // key events timeline
  createdAt       DateTime @default(now())

  @@index([experienceId])
  @@index([userId])
}

model PlayerChallengeRecord {
  id              String   @id @default(cuid())
  fromUserId      String
  toUserId        String?  // null = open challenge
  experienceId    String
  experienceName  String
  type            String   // beat-score | speedrun | survival | no-damage | high-score
  description     String
  fromScore       Int?
  targetScore     Int?
  rewardLiquid    Int      @default(0)
  status          String   @default("PENDING")  // PENDING | ACCEPTED | COMPLETED | DECLINED | EXPIRED
  winnerId        String?
  entriesJson     String   @default("[]")  // [{userId, score, at}]
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([experienceId])
}

model NotificationRecord {
  id              String   @id @default(cuid())
  userId          String
  type            String   // follow | challenge | achievement | live | replay | comment | fork | evolution | reward
  title           String
  body            String
  icon            String   @default("🔔")
  targetType      String?  // experience | creator | challenge | replay | collection
  targetId        String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ─── v0.47 Identity Universe — Communities + Game Lifecycle + Creator Posts ─

model CommunitySpaceRecord {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  experienceName  String
  creatorId       String
  memberCount     Int      @default(0)
  description     String   @default("")
  rules           String   @default("Be kind. Play hard. Create freely.")
  createdAt       DateTime @default(now())

  posts           CommunityPostRecord[]
  members         CommunityMemberRecord[]
}

model CommunityMemberRecord {
  id              String   @id @default(cuid())
  communityId     String
  userId          String
  displayName     String
  role            String   @default("member")  // member | moderator | admin
  joinedAt        DateTime @default(now())

  community       CommunitySpaceRecord @relation(fields: [communityId], references: [id])
  @@unique([communityId, userId])
}

model CommunityPostRecord {
  id              String   @id @default(cuid())
  communityId     String
  userId          String
  displayName     String
  type            String   @default("discussion")  // discussion | strategy | build | challenge | poll | announcement
  title           String
  body            String
  upvotes         Int      @default(0)
  commentCount    Int      @default(0)
  pinned          Boolean  @default(false)
  pollOptionsJson String   @default("[]")  // for polls: [{option, votes}]
  createdAt       DateTime @default(now())

  community       CommunitySpaceRecord @relation(fields: [communityId], references: [id])
  @@index([communityId])
}

model GameLifecycleEventRecord {
  id              String   @id @default(cuid())
  experienceId    String
  experienceName  String
  milestone       String   // created | first-play | 100-players | 1k-players | first-fork | evolved | tournament | legendary | viral | community-formed
  title           String
  description     String
  icon            String   @default("🎮")
  metadataJson    String   @default("{}")
  achievedAt      DateTime @default(now())

  @@index([experienceId])
}

model CreatorPostRecord {
  id              String   @id @default(cuid())
  creatorId       String
  creatorName     String
  type            String   @default("update")  // update | announcement | devlog | behind-the-scenes | question | poll
  title           String
  body            String
  mediaUrl        String?
  pinned          Boolean  @default(false)
  likeCount       Int      @default(0)
  commentCount    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([creatorId])
}

// ─── v0.48 Creator Intelligence Universe ───────────────────────────────────
// (CreatorInsightRecord moved to Phase 19 section below)
// (CreatorExperimentRecord moved to Phase 19 section below)

model GameEvolutionPlanRecord {
  id              String   @id @default(cuid())
  experienceId    String
  experienceName  String
  creatorId       String
  currentStage    String   @default("birth")  // birth | growth | optimization | expansion | civilization
  proposedStage   String?
  stepsJson       String   @default("[]")  // [{step, description, status, projectedImpact}]
  projectedRetention Float @default(0)
  projectedRevenue  Float  @default(0)
  status          String   @default("DRAFT")  // DRAFT | APPROVED | IN_PROGRESS | COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([experienceId])
}

model CreatorMarketplaceItemRecord {
  id              String   @id @default(cuid())
  creatorId       String
  creatorName     String
  type            String   // extension | mechanic | template | npc | world | asset-pack | ai-agent
  name            String
  description     String
  icon            String   @default("📦")
  priceRoyaltyBps Int      @default(500)  // basis points (500 = 5%)
  usedByCount     Int      @default(0)
  rating          Float    @default(5.0)
  revenueImpact   Float    @default(0)  // projected % revenue increase
  tagsJson        String   @default("[]")
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([creatorId])
  @@index([type])
}

// ─── v0.49 Asset Economy Universe ──────────────────────────────────────────

model AssetEconomyRecord {
  id              String   @id @default(cuid())
  assetId         String   @unique  // asset://type/name-v1
  name            String
  description     String
  icon            String   @default("📦")
  type            String   // character | mechanic | ai-agent | template | item | world-seed
  assetClass      String   @default("creator")  // creator | player | platform
  creatorId       String
  creatorName     String
  version         Int      @default(1)
  parentAssetId   String?  // lineage: previous version
  configJson      String   @default("{}")  // asset configuration/data
  tagsJson        String   @default("[]")
  royaltyBps      Int      @default(500)  // royalty in basis points
  priceLiquid     Int      @default(0)  // purchase price in micro-Liquid (0 = free)
  status          String   @default("PUBLISHED")  // DRAFT | PUBLISHED | ARCHIVED
  // Reputation
  qualityScore    Int      @default(50)
  performanceScore Int     @default(50)
  adoptionScore   Int      @default(0)
  fairnessScore   Int      @default(50)
  innovationScore Int      @default(50)
  // Stats
  installCount    Int      @default(0)
  usageCount      Int      @default(0)
  totalRevenue    Int      @default(0)  // micro-Liquid earned
  rating          Float    @default(5.0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([creatorId])
  @@index([assetClass])
}

model AssetOwnershipRecord {
  id              String   @id @default(cuid())
  assetId         String   // references AssetEconomyRecord.id
  ownerId         String   // userId or creatorId
  ownerType       String   // player | creator
  acquiredAt      DateTime @default(now())
  acquiredFrom    String?  // "marketplace" | "reward" | "creation" | "transfer"
  pricePaid       Int      @default(0)  // micro-Liquid
  metadataJson    String   @default("{}")

  @@unique([assetId, ownerId])
  @@index([ownerId])
}

model AssetInstallationRecord {
  id              String   @id @default(cuid())
  assetId         String
  experienceId    String
  experienceName  String
  installedBy     String
  installedAt     DateTime @default(now())
  status          String   @default("ACTIVE")  // ACTIVE | REMOVED
  usageDataJson   String   @default("{}")  // runtime usage stats

  @@index([assetId])
  @@index([experienceId])
}

model AssetRoyaltyRecord {
  id              String   @id @default(cuid())
  assetId         String
  experienceId    String
  experienceName  String
  totalRevenue    Int      @default(0)  // micro-Liquid generated
  assetCreatorShare Int    @default(0)  // micro-Liquid to asset creator
  gameCreatorShare Int    @default(0)  // micro-Liquid to game creator
  platformShare    Int    @default(0)  // micro-Liquid to platform
  txId            String?  // ledger transaction ID
  createdAt       DateTime @default(now())

  @@index([assetId])
  @@index([experienceId])
}

model AssetEventRecord {
  id              String   @id @default(cuid())
  assetId         String
  eventType       String   // created | published | installed | used | evolved | forked | royalty_generated | transferred | rated
  actorId         String
  actorName       String
  detail          String?
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([assetId])
  @@index([eventType])
}

// ─── v0.50 Multiverse — Civilization Network ───────────────────────────────

model WorldIdentityRecord {
  id                String   @id @default(cuid())
  worldId           String   @unique
  worldName         String
  founderId         String
  founderName       String
  civilizationLevel String   @default("village")  // settlement | village | town | city | metropolis | empire
  population        Int      @default(0)
  influenceScore    Int      @default(0)
  cultureDNA        String   @default("{}")  // { agriculture: 80, trade: 70, combat: 30, ... }
  economyDNA        String   @default("{}")  // { currency: "Liquid", tradeVolume: 0, gdp: 0 }
  governanceDNA     String   @default("{}")  // { type: "creator", stability: 50, ... }
  era               String   @default("founding")  // founding | growth | golden | expansion | decline
  visitors          Int      @default(0)
  citizens          Int      @default(0)
  alliancesCount    Int      @default(0)
  rivalriesCount    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([civilizationLevel])
}

model WorldRelationRecord {
  id              String   @id @default(cuid())
  fromWorldId     String
  fromWorldName   String
  toWorldId       String
  toWorldName     String
  type            String   // ALLIANCE | TRADE_AGREEMENT | COMPETITION | WAR | CULTURAL_EXCHANGE | MIGRATION_TREATY
  status          String   @default("ACTIVE")  // PENDING | ACTIVE | DISSOLVED
  terms           String   @default("{}")  // { exports: [], imports: [], benefits: {} }
  strength        Int      @default(50)  // 0-100
  createdAt       DateTime @default(now())

  @@unique([fromWorldId, toWorldId, type])
  @@index([fromWorldId])
  @@index([toWorldId])
}

model WorldMigrationRecord {
  id              String   @id @default(cuid())
  userId          String
  displayName     String
  fromWorldId     String?
  fromWorldName   String?
  toWorldId       String
  toWorldName     String
  migrationType   String   @default("visit")  // visit | immigrate | trade | diplomacy | tourism
  assetsCarried   String   @default("[]")  // asset IDs that traveled with the player
  reputationCarried Int    @default(0)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([toWorldId])
}

model WorldTradeRecord {
  id              String   @id @default(cuid())
  fromWorldId     String
  fromWorldName   String
  toWorldId       String
  toWorldName     String
  assetId         String?
  assetName       String?
  resourceType    String   // asset | resource | currency | knowledge
  amount          Int      @default(0)  // micro-Liquid or quantity
  tradeType       String   @default("export")  // export | import | exchange | gift
  txId            String?  // ledger transaction ID
  createdAt       DateTime @default(now())

  @@index([fromWorldId])
  @@index([toWorldId])
}

model CivilizationEventRecord {
  id              String   @id @default(cuid())
  worldId         String?
  worldName       String?
  eventType       String   // WORLD_FOUNDED | FIRST_TRADE | FIRST_ALLIANCE | MILLION_PLAYER | GOLDEN_AGE | CIVILIZATION_COLLAPSE | WORLD_MERGER | MIGRATION_WAVE | CULTURAL_RENAISSANCE
  title           String
  narrative       String
  icon            String   @default("📜")
  impact          String   @default("{}")  // { influence: +50, population: +1000 }
  isGlobal        Boolean  @default(false)  // true = affects entire multiverse
  createdAt       DateTime @default(now())

  @@index([worldId])
  @@index([eventType])
}

model WorldAICouncilRecord {
  id              String   @id @default(cuid())
  worldId         String   @unique
  worldName       String
  governorState   String   @default("{}")  // AI Governor memory + decisions
  economyState    String   @default("{}")  // AI Economy manager state
  cultureState    String   @default("{}")  // AI Culture manager state
  defenseState    String   @default("{}")  // AI Defense manager state
  historianState  String   @default("{}")  // AI Historian chronicle
  lastCouncilTick Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── v0.51 Living Civilizations — Time, Seasons, Events, Feed, Missions ───

model CivilizationTickRecord {
  id              String   @id @default(cuid())
  worldId         String
  worldName       String
  tickNumber      Int
  season          String   @default("spring")  // spring | summer | autumn | winter
  seasonDay       Int      @default(1)  // day within the season (1-7)
  populationBefore Int
  populationAfter  Int
  economyChange   Int      @default(0)  // delta in trade volume (micro-Liquid)
  influenceChange Int      @default(0)
  eventsGenerated Int      @default(0)
  narrative       String   @default("")  // "Day 7: The harvest brought 200 new citizens..."
  timestamp       DateTime @default(now())

  @@index([worldId])
  @@index([tickNumber])
}

model CivilizationFeedItemRecord {
  id              String   @id @default(cuid())
  worldId         String
  worldName       String
  type            String   // population | economy | culture | diplomacy | conflict | discovery | season | mission | migration | achievement
  title           String
  body            String
  icon            String   @default("📰")
  impact          String   @default("{}")  // { influence: +10, population: +50 }
  isGlobal        Boolean  @default(false)  // appears in global multiverse feed
  tickNumber      Int?
  createdAt       DateTime @default(now())

  @@index([worldId])
  @@index([type])
  @@index([isGlobal])
}

model CivilizationMissionRecord {
  id              String   @id @default(cuid())
  worldId         String
  worldName       String
  title           String
  description     String
  icon            String   @default("🎯")
  type            String   // community | economic | cultural | competitive | expansion
  goalType        String   // population | tradeVolume | influence | citizens | events
  goalTarget      Int
  goalCurrent     Int      @default(0)
  rewardType      String   // influence | population | economy | asset | level
  rewardAmount    Int
  rewardDescription String
  status          String   @default("ACTIVE")  // ACTIVE | COMPLETED | EXPIRED
  participantsJson String  @default("[]")  // userIds who contributed
  season          String?  // which season this mission belongs to
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([worldId])
  @@index([status])
}

model CivilizationSeasonRecord {
  id              String   @id @default(cuid())
  worldId         String
  worldName       String
  season          String   // spring | summer | autumn | winter
  year            Int      @default(1)
  startDate       DateTime @default(now())
  endDate         DateTime?
  effects         String   @default("{}")  // { populationGrowth: 1.2, tradeBonus: 1.1, ... }
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([worldId])
  @@index([isActive])
}

// ─── v0.52 Living Economies — Resources, Markets, Trade Routes, Buildings ──

model CivilizationResourceRecord {
  id              String   @id @default(cuid())
  worldId         String
  worldName       String
  resourceType    String   // food | wood | metal | knowledge | culture | energy | technology
  supply          Int      @default(100)
  demand          Int      @default(50)
  productionRate  Int      @default(10)  // per tick
  consumptionRate Int      @default(5)   // per tick
  price           Int      @default(100)  // micro-Liquid per unit
  priceHistory    String   @default("[]")  // [{tick, price}]
  lastTickUpdated Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([worldId, resourceType])
  @@index([worldId])
}

model CivilizationMarketRecord {
  id              String   @id @default(cuid())
  worldId         String
  worldName       String
  resourceType    String
  action          String   // buy | sell
  quantity        Int
  pricePerUnit    Int      // micro-Liquid
  totalValue      Int      // micro-Liquid
  buyerId         String?  // userId or worldId
  sellerId        String?
  tickNumber      Int?
  createdAt       DateTime @default(now())

  @@index([worldId])
  @@index([resourceType])
}

model TradeRouteRecord {
  id              String   @id @default(cuid())
  fromWorldId     String
  fromWorldName   String
  toWorldId       String
  toWorldName     String
  resourceType    String   // what's being traded
  quantity        Int      @default(10)  // per tick
  pricePerUnit    Int      @default(100)
  totalGenerated  Int      @default(0)  // total micro-Liquid generated
  ticksActive     Int      @default(0)
  status          String   @default("ACTIVE")  // ACTIVE | SUSPENDED | ENDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fromWorldId])
  @@index([toWorldId])
}

model CivilizationBuildingRecord {
  id              String   @id @default(cuid())
  worldId         String
  worldName       String
  name            String
  type            String   // townhall | market | farm | mine | library | temple | barracks | port | monument | district
  icon            String   @default("🏛️")
  level           Int      @default(1)
  economicModifier String  @default("{}")  // { foodProduction: +10, tradeBonus: +5 }
  builtAtTick     Int
  builtBy         String   @default("system")
  status          String   @default("ACTIVE")  // ACTIVE | UPGRADING | DEMOLISHED
  createdAt       DateTime @default(now())

  @@index([worldId])
  @@index([type])
}

model PlayerRoleRecord {
  id              String   @id @default(cuid())
  userId          String
  displayName     String
  worldId         String
  worldName       String
  role            String   @default("visitor")  // visitor | citizen | specialist | guild_member | leader
  specialty       String?  // trading | farming | combat | building | exploration | governance
  guildId         String?  // guild membership
  contribution    Int      @default(0)  // economic contribution to civilization
  influenceInWorld Int     @default(0)  // political influence
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, worldId])
  @@index([worldId])
  @@index([userId])
}

// ─── ADR Freeze: Economic & Architectural Alignment ────────────────────────

// ADR-006: Liquid as purchased value (1 Liquid = 1 XOF)
model LiquidWalletRecord {
  id              String   @id @default(cuid())
  userId          String   @unique
  balanceXof      Int      @default(0)  // micro-XOF (1 XOF = 1,000,000 micro)
  totalPurchased  Int      @default(0)
  totalSpent      Int      @default(0)
  totalWon        Int      @default(0)  // from leaderboard payouts only
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LiquidPurchaseRecord {
  id              String   @id @default(cuid())
  userId          String
  amountXof       Int      // micro-XOF purchased
  paymentProvider String   @default("payswap")  // payswap | stripe | future
  paymentRef      String?  // provider transaction reference
  status          String   @default("PENDING")  // PENDING | COMPLETED | FAILED
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

// ADR-008: Purchased Minutes for competitive play
model MinutePurchaseRecord {
  id              String   @id @default(cuid())
  userId          String
  experienceId    String
  experienceName  String
  minutesPurchased Int
  pricePerMinuteXof Int    // micro-XOF per minute
  totalPaidXof    Int
  minutesUsed     Int      @default(0)
  status          String   @default("ACTIVE")  // ACTIVE | EXHAUSTED | REFUNDED
  createdAt       DateTime @default(now())
}

// ADR-007: Prize Pool & Leaderboard Payouts
model PrizePoolRecord {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  experienceName  String
  totalAccumulated Int     @default(0)  // micro-XOF from competitive sessions
  totalDistributed Int     @default(0)
  currentBalance  Int      @default(0)
  // Revenue split config (BPS — basis points, 10000 = 100%)
  platformShareBps Int     @default(2000)  // 20%
  creatorShareBps  Int     @default(3000)  // 30%
  prizePoolShareBps Int    @default(5000)  // 50%
  // Leaderboard payout config (BPS of prize pool)
  firstPlaceBps    Int     @default(2500)  // 25% of prize pool
  secondPlaceBps   Int     @default(1500)  // 15%
  thirdPlaceBps    Int     @default(1000)  // 10%
  // Remaining 50% stays in pool for next cycle
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LeaderboardPayoutRecord {
  id              String   @id @default(cuid())
  prizePoolId     String
  experienceId    String
  userId          String
  displayName     String
  rank            Int
  payoutXof       Int
  txId            String?  // ledger transaction ID
  payoutCycle     String   // e.g., "2026-08-W1"
  createdAt       DateTime @default(now())
}

// ADR-009: Extension Royalties from Creator Share
model ExtensionRoyaltyConfigRecord {
  id              String   @id @default(cuid())
  extensionId     String   // references extension manifest ID
  extensionName   String
  royaltyBps      Int      @default(500)  // BPS of creator's share (500 = 5%)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([extensionId])
}

model ExtensionRoyaltyDistributionRecord {
  id              String   @id @default(cuid())
  experienceId    String
  extensionId     String
  extensionName   String
  extensionCreatorId String
  gameCreatorId   String
  grossRevenueXof Int      // total revenue from this game's session
  creatorShareXof Int      // creator's 30% portion
  extensionRoyaltyXof Int  // what the extension creator receives
  gameCreatorNetXof Int    // what the game creator keeps after extension royalties
  txId            String?
  createdAt       DateTime @default(now())
}

// ADR-010: Tournaments (separate from games)
model TournamentRecord {
  id              String   @id @default(cuid())
  name            String
  description     String
  organizerId     String
  organizerName   String
  status          String   @default("UPCOMING")  // UPCOMING | ACTIVE | COMPLETED | CANCELLED
  startsAt        DateTime
  endsAt          DateTime
  prizePoolXof    Int      @default(0)
  entryFeeXof     Int      @default(0)
  experiencesJson String   @default("[]")  // array of experience IDs in this tournament
  teamDistributionPolicy String @default("equal")  // equal | weighted | leader | custom
  maxTeams        Int?
  maxTeamSize     Int      @default(5)
  admissionType   String   @default("open")  // open | application | invite
  createdAt       DateTime @default(now())
}

model TournamentTeamRecord {
  id              String   @id @default(cuid())
  tournamentId    String
  name            String
  captainId       String
  captainName     String
  membersJson     String   @default("[]")  // [{userId, displayName}]
  status          String   @default("ACTIVE")
  totalScore      Int      @default(0)
  rank            Int?
  createdAt       DateTime @default(now())
}

// ADR-011: Highlights & AI Clips
model HighlightRecord {
  id              String   @id @default(cuid())
  replayId        String
  experienceId    String
  experienceName  String
  userId          String
  displayName     String
  triggerType     String   // leaderboard_first | podium | world_record | comeback | exceptional | high_score
  title           String
  description     String
  durationMs      Int
  scoreAtHighlight Int
  thumbnailUrl    String?
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  isAiGenerated   Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([experienceId])
  @@index([triggerType])
}

// ADR-005: Game Containment Configuration
model GameContainmentConfigRecord {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  runtimeType     String   @default("native")  // native | html5 | external
  viewportMode    String   @default("responsive")  // responsive | fixed | fullscreen
  aspectRatio     String?  // "16:9" | "9:16" | "1:1" | null = fluid
  minViewportW    Int      @default(320)
  minViewportH    Int      @default(240)
  inputSchemes    String   @default("[\"touch\",\"keyboard\"]")
  orientation     String   @default("any")  // portrait | landscape | any
  externalUrl     String?
  html5BundleUrl  String?
  sandboxLevel    String   @default("strict")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Phase 17: Extension Operating System Unification ─────────────────────

model ExtensionInstallationRecord {
  id              String   @id @default(cuid())
  extensionId     String
  experienceId    String
  experienceName  String
  installedVersion Int     @default(1)
  installedBy     String
  revenueGenerated Int     @default(0)  // micro-XOF generated through this installation
  installedAt     DateTime @default(now())

  extension       ExtensionRecord @relation(fields: [extensionId], references: [id])

  @@unique([extensionId, experienceId])
  @@index([experienceId])
}

// ─── Phase 18: Consumer Alignment — Replays, Live, Sparks ──────────────────

model ReplayEventRecord {
  id              String   @id @default(cuid())
  replayId        String
  timestamp       Int      // ms from start
  eventType       String   // start | score_milestone | mechanic_activation | leaderboard_change | rare_event | near_miss | completion
  extensionId     String?
  description     String
  scoreAtEvent    Int?
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([replayId])
}

model LiveStreamRecord {
  id              String   @id @default(cuid())
  sessionId       String
  experienceId    String
  experienceName  String
  playerId        String
  playerName      String
  status          String   @default("LIVE")  // LIVE | ENDED
  viewerCount     Int      @default(0)
  peakViewers     Int      @default(0)
  streamProvider  String   @default("internal")
  startedAt       DateTime @default(now())
  endedAt         DateTime?
}

model SparkPresentationConfigRecord {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  orientation     String   @default("portrait")  // portrait | landscape
  maxDurationSeconds Int   @default(180)
  autoplay        Boolean  @default(true)
  previewAsset    String?
  interactionMode String   @default("tap")  // tap | swipe | tilt | hold
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Phase 19: Creator Operating System ────────────────────────────────────

model CreatorExperimentRecord {
  id              String   @id @default(cuid())
  creatorId       String
  experienceId    String
  experienceName  String
  name            String
  hypothesis      String
  type            String   @default("difficulty")  // difficulty | economy | extension | layout | pricing
  variantAJson    String   @default("{}")
  variantBJson    String   @default("{}")
  status          String   @default("DRAFT")  // DRAFT | RUNNING | COMPLETED | CANCELLED
  winner          String?  // "A" | "B" | null
  metricsJson     String   @default("{}")  // { retention: {A: 0.6, B: 0.72}, completion: {A: 0.4, B: 0.5} }
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([creatorId])
  @@index([experienceId])
}

model CreatorRevenueRecord {
  id              String   @id @default(cuid())
  creatorId       String
  experienceId    String?
  experienceName  String?
  source          String   // COMPETITIVE_PLAY | EXTENSION_ROYALTY | TOURNAMENT | SPONSORSHIP
  amountXof       Int      // micro-XOF
  description     String?
  createdAt       DateTime @default(now())

  @@index([creatorId])
  @@index([source])
}

model CreatorInsightRecord {
  id              String   @id @default(cuid())
  creatorId       String
  experienceId    String?
  experienceName  String?
  category        String   // retention | economy | difficulty | social | evolution | opportunity
  problem         String
  evidence        String
  recommendation  String
  expectedImpact  String
  severity        String   @default("info")  // info | suggestion | warning | critical
  status          String   @default("PENDING")  // PENDING | ACCEPTED | DISMISSED | APPLIED
  reportType      String   @default("daily")  // daily | weekly | monthly
  createdAt       DateTime @default(now())

  @@index([creatorId])
  @@index([status])
}

model ExperienceVersionRecord {
  id              String   @id @default(cuid())
  experienceId    String
  experienceName  String
  version         Int
  bundleHash      String?
  changeSummary   String
  metricsBeforeJson String  @default("{}")  // { playCount, retention, revenue }
  metricsAfterJson  String  @default("{}")
  createdBy        String
  createdAt       DateTime @default(now())

  @@index([experienceId])
}
