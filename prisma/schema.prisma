// PlayLiquid Experience Kernel v0.1 — Prisma schema
// The kernel persists: registered extensions, compiled bundles, sessions,
// the double-entry ledger, token balances/events, and telemetry/genomes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Extensions & Bundles ───────────────────────────────────────────────────

model ExtensionRecord {
  id           String   @id // matches manifest.id, e.g. "pl.physics"
  slug         String   @unique
  name         String
  description  String
  author       String
  category     String
  kind         String
  trustLevel   String
  determinism  String
  manifestJson String   // full manifest as JSON
  createdAt    DateTime @default(now())

  instances BundleInstance[]
}

model BundleRecord {
  contentHash   String   @id // FNV-1a fingerprint from compiler
  experienceId  String
  type          String // GAME | SPARK
  name          String?
  bundleJson    String // full bundle spec as JSON
  deterministic Boolean
  createdAt     DateTime @default(now())

  instances    BundleInstance[]
  sessions     PlaySession[]
  genome       ExperienceGenomeRecord?
}

model BundleInstance {
  id            String   @id @default(cuid())
  bundleHash    String
  instanceId    String // local id within bundle
  extensionId   String
  role          String?
  configJson    String  @default("{}")
  bundle        BundleRecord   @relation(fields: [bundleHash], references: [contentHash])
  extension     ExtensionRecord @relation(fields: [extensionId], references: [id])
}

// ─── Sessions ──────────────────────────────────────────────────────────────

model PlaySession {
  id            String   @id @default(cuid())
  experienceId  String
  bundleHash    String?
  mode          String // PREVIEW | EARN
  seed          String
  userId        String?
  status        String  @default("ACTIVE") // ACTIVE | ENDED | SUSPENDED
  tickCount     Int      @default(0)
  actionCount   Int      @default(0)
  score         Int      @default(0)
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  bundle        BundleRecord? @relation(fields: [bundleHash], references: [contentHash])
  tokenEvents   TokenEventRecord[]
  tokenBalances TokenBalanceRecord[]
  telemetry     ExperienceEventRecord?
  player        PlayerProfile? @relation(fields: [userId], references: [userId])
}

// ─── Liquid Ledger (double-entry) ──────────────────────────────────────────

model LedgerAccountRecord {
  id        String   @id // e.g. "player:wallet:user_1"
  kind      String
  balance   BigInt   @default(0) // micro-Liquid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries LedgerEntryRecord[]
}

model LedgerTxRecord {
  id        String   @id @default(cuid())
  memo      String?
  createdAt DateTime @default(now())
  entries   LedgerEntryRecord[]
}

model LedgerEntryRecord {
  id        String   @id @default(cuid())
  txId      String
  account   String
  debit     BigInt   @default(0)
  credit    BigInt   @default(0)
  memo      String?
  lineNo    Int
  createdAt DateTime @default(now())

  tx        LedgerTxRecord     @relation(fields: [txId], references: [id])
  accountRef LedgerAccountRecord @relation(fields: [account], references: [id])
}

// ─── Extension Tokens ──────────────────────────────────────────────────────

model TokenBalanceRecord {
  id        String   @id @default(cuid())
  sessionId String
  symbol    String
  balance   Int      @default(0)
  scope     String   @default("session")
  session   PlaySession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, symbol])
}

model TokenEventRecord {
  id        String   @id @default(cuid())
  sessionId String
  kind      String   // EMIT | CONSUME | SETTLE | REJECT
  symbol    String
  amount    Int
  instance  String?
  reason    String?
  tick      Int?
  createdAt DateTime @default(now())
  session   PlaySession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

// ─── Telemetry & Genome ────────────────────────────────────────────────────

model ExperienceEventRecord {
  id                 String   @id @default(cuid())
  experienceId       String
  sessionId          String   @unique
  bundleHash         String?
  tickCount          Int
  sessionDurationMs  Int
  actions            Int
  completion         Boolean
  score              Int?
  tokensEmittedJson  String   @default("{}")
  tokensConsumedJson String   @default("{}")
  extensionsJson     String   @default("[]")
  createdAt          DateTime @default(now())

  session            PlaySession @relation(fields: [sessionId], references: [id])
}

model ExperienceGenomeRecord {
  id              String   @id @default(cuid())
  experienceId    String
  bundleHash      String   @unique
  extensionsJson  String
  categoriesJson  String
  mechanicsJson   String
  compositionDepth Int
  hasEconomy      Boolean
  hasAI           Boolean
  tokenCount      Int
  computedAt      DateTime @default(now())

  bundle          BundleRecord @relation(fields: [bundleHash], references: [contentHash])
}

// ─── Studio: Creators & Published Experiences ──────────────────────────────

model CreatorRecord {
  id            String   @id @default(cuid())
  handle        String   @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  followers     Int      @default(0)
  totalLiquid   Int      @default(0)  // micro-Liquid earned
  playerHours   Int      @default(0)  // total play time in seconds
  // ── Identity Layer v0.45 ──────────────────────────────────────────────
  creatorLevel  Int      @default(1)
  creatorXP     Int      @default(0)
  creatorGenomeJson String @default("{}")  // { strategy: 94, economy: 88, social: 71 }
  reputationJson String  @default("{}")    // { quality: 94, innovation: 87, fairness: 98 }
  createdAt     DateTime @default(now())

  experiences   ExperienceRecord[]
}

model ExperienceRecord {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  description         String
  creatorId           String
  bundleHash          String?
  parentExperienceId  String?  // fork lineage
  intentJson          String   @default("{}")  // ExperienceIntent
  genomeJson          String?  // computed at publish
  status              String   @default("DRAFT")  // DRAFT | PUBLISHED | ARCHIVED
  playCount           Int      @default(0)
  forkCount           Int      @default(0)
  likeCount           Int      @default(0)
  createdAt           DateTime @default(now())
  publishedAt         DateTime?

  creator             CreatorRecord @relation(fields: [creatorId], references: [id])
  parent              ExperienceRecord? @relation("ForkTree", fields: [parentExperienceId], references: [id])
  forks               ExperienceRecord[] @relation("ForkTree")
}

// ─── World Engine v0.2 ─────────────────────────────────────────────────────

model PlayerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  displayName         String
  avatarUrl           String?
  bio                 String?
  playerGenomeJson    String   @default("{}")  // favorite genres, emotions, skill
  creatorScore        Int      @default(0)
  playerScore         Int      @default(0)
  collaborationScore  Int      @default(0)
  trustScore          Int      @default(50)    // 0-100
  achievementsJson    String   @default("[]")
  followersJson       String   @default("[]")  // userIds of followers
  followingJson       String   @default("[]")  // userIds being followed
  friendsJson         String   @default("[]")  // bidirectional friend userIds
  liquidBalance       Int      @default(0)     // micro-Liquid earned as player
  // ── Identity Layer v0.45 ──────────────────────────────────────────────
  playerLevel         Int      @default(1)
  playerXP            Int      @default(0)
  skillsJson          String   @default("{}")  // { farming: 82, trading: 74, ... }
  reputationJson      String   @default("{}")  // { builder: 90, trader: 85, ... }
  inventoryJson       String   @default("[]")  // array of InventoryItem
  worldPassportJson   String   @default("{}")  // { visited: [], citizenships: [] }
  companionStateJson  String   @default("{}")  // AI companion memory + personality
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  follows             ExperienceFollow[]
  comments            ExperienceComment[]
  sessions            PlaySession[]
  activityFeed        ActivityFeedRecord[]
  ratings             ExperienceRatingRecord[]
}

model ExperienceFollow {
  id            String   @id @default(cuid())
  userId        String
  experienceId  String
  createdAt     DateTime @default(now())

  player        PlayerProfile @relation(fields: [userId], references: [userId])
  @@unique([userId, experienceId])
}

model ExperienceComment {
  id            String   @id @default(cuid())
  experienceId  String
  userId        String
  body          String
  createdAt     DateTime @default(now())

  player        PlayerProfile @relation(fields: [userId], references: [userId])
}

model ExperienceMetrics {
  id                String   @id @default(cuid())
  experienceId      String   @unique
  totalSessions     Int      @default(0)
  totalPlayTimeMs   Int      @default(0)
  completionRate    Float    @default(0)
  averageScore      Float    @default(0)
  averageDropOffMs  Int      @default(0)
  retention1d       Float    @default(0)
  retention7d       Float    @default(0)
  frustrationEvents Int      @default(0)
  achievementEvents Int      @default(0)
  surpriseEvents    Int      @default(0)
  socialMoments     Int      @default(0)
  tokensEarned      Int      @default(0)
  tokensSpent       Int      @default(0)
  marketActions     Int      @default(0)
  forks             Int      @default(0)
  shares            Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model EvolutionProposal {
  id              String   @id @default(cuid())
  experienceId    String
  analysisJson    String   @default("{}")  // AI reasoning, patterns found
  proposedChangesJson String @default("{}")  // what to change in the graph
  predictedLift   Float    @default(0)     // e.g. 0.18 = +18% retention
  newBundleJson   String?  // the proposed fork bundle
  status          String   @default("PENDING")  // PENDING | APPROVED | REJECTED | APPLIED
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?
}

model SimulationRun {
  id              String   @id @default(cuid())
  experienceId    String
  playerCount     Int
  variantLabel    String?  // "A", "B", "C"
  variantConfigJson String @default("{}")
  metricsJson     String   @default("{}")
  status          String   @default("RUNNING")  // RUNNING | COMPLETED
  createdAt       DateTime @default(now())
  completedAt     DateTime?
}

model RoyaltyNode {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  sharesJson      String   @default("[]")  // [{creatorId, shareBps, role}]
  updatedAt       DateTime @updatedAt
}

// ─── Civilization Engine v0.3 ──────────────────────────────────────────────

model WorldRecord {
  id              String   @id @default(cuid())
  name            String
  description     String
  experienceId    String
  creatorId       String
  status          String   @default("DORMANT")  // DORMANT | ACTIVE | PAUSED | ENDED
  tickCount       Int      @default(0)
  population      Int      @default(0)
  worldGenomeJson String   @default("{}")
  macroStateJson  String   @default("{}")
  createdAt       DateTime @default(now())
  lastTickAt      DateTime?

  entities        WorldEntityRecord[]
  events          WorldEventRecord[]
  assets          AssetRecord[]
  ticks           WorldTickRecord[]
  history         WorldHistoryRecord[]
  relationships   RelationshipRecord[]
}

model WorldEntityRecord {
  id              String   @id @default(cuid())
  worldId         String
  name            String
  type            String   // CITIZEN | MERCHANT | BUILDER | EXPLORER | COMPETITOR | ORGANIZATION | RESOURCE_NODE | PLAYER
  agentGenomeJson String   @default("{}")
  wealth          Int      @default(0)   // micro-Liquid
  resourcesJson   String   @default("{}")
  reputation      Int      @default(0)
  relationshipsJson String @default("{}")
  memoryJson      String   @default("[]")
  lastDecisionTick Int     @default(0)
  alive           Boolean  @default(true)
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
  ownedAssets     AssetRecord[]
}

model RelationshipRecord {
  id              String   @id @default(cuid())
  worldId         String
  fromEntityId    String
  toEntityId      String
  type            String   // owns | trades | competes | collaborates | trusts | fears | allied | rival
  strength        Int      @default(50)
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

model WorldEventRecord {
  id              String   @id @default(cuid())
  worldId         String
  name            String
  description     String
  type            String   // economic | social | environmental | competitive | crisis | discovery
  tick            Int
  effectsJson     String   @default("{}")
  rewardsJson     String   @default("{}")
  storyText       String   @default("")
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

model AssetRecord {
  id              String   @id @default(cuid())
  worldId         String
  name            String
  type            String   // land | building | business | item | infrastructure
  ownerId         String?
  purchasePrice   Int      @default(0)
  generationRateJson String @default("{}")
  forSale         Boolean  @default(false)
  askingPrice     Int?
  createdAt       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
  owner           WorldEntityRecord? @relation(fields: [ownerId], references: [id])
}

model WorldTickRecord {
  id              String   @id @default(cuid())
  worldId         String
  tick            Int
  stateSnapshotJson String @default("{}")
  eventsJson      String   @default("[]")
  decisionsCount  Int      @default(0)
  timestamp       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

model WorldHistoryRecord {
  id              String   @id @default(cuid())
  worldId         String
  tick            Int
  type            String   // founding | event | milestone | crisis | discovery | social | economic
  title           String
  narrative       String
  timestamp       DateTime @default(now())

  world           WorldRecord @relation(fields: [worldId], references: [id])
}

// ─── Universe v0.4 — Consumer Platform Layer ───────────────────────────────

model ActivityFeedRecord {
  id              String   @id @default(cuid())
  userId          String   // who performed the action
  type            String   // played | forked | published | followed | earned | evolved | rated | joined
  targetType      String   // experience | creator | world | spark
  targetId        String?
  targetName      String?
  detail          String?  // extra context
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  player          PlayerProfile @relation(fields: [userId], references: [userId])
}

model ExperienceRatingRecord {
  id              String   @id @default(cuid())
  experienceId    String
  userId          String
  overallScore    Int      @default(50)  // 0-100 reputation score
  completionScore Int      @default(50)
  returnScore     Int      @default(50)
  socialScore     Int      @default(50)
  emotionScore    Int      @default(50)
  economyScore    Int      @default(50)
  reviewText      String?
  createdAt       DateTime @default(now())

  player          PlayerProfile @relation(fields: [userId], references: [userId])
  @@unique([experienceId, userId])
}

model FriendRequestRecord {
  id              String   @id @default(cuid())
  fromUserId      String
  toUserId        String
  status          String   @default("PENDING")  // PENDING | ACCEPTED | REJECTED
  createdAt       DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

// ─── Identity Layer v0.45 — Persistent Identity ───────────────────────────

model AchievementRecord {
  id              String   @id @default(cuid())
  userId          String
  achievementId   String   // e.g. "first-play", "top-trader", "world-founder"
  title           String
  description     String
  icon            String   @default("🏆")
  category        String   // play | create | social | economy | exploration | mastery
  rarity          String   @default("common")  // common | rare | epic | legendary
  xpReward        Int      @default(10)
  metadataJson    String   @default("{}")
  earnedAt        DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model InventoryItemRecord {
  id              String   @id @default(cuid())
  userId          String
  itemId          String   // unique item identifier
  name            String
  description     String
  icon            String   @default("📦")
  type            String   // asset | reward | achievement | resource | cosmetic | tool
  rarity          String   @default("common")  // common | rare | epic | legendary | mythic
  quantity        Int      @default(1)
  worldId         String?  // which world it came from (null = universal)
  metadataJson    String   @default("{}")
  acquiredAt      DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

model WorldVisitRecord {
  id              String   @id @default(cuid())
  userId          String
  worldId         String
  worldName       String
  visitCount      Int      @default(1)
  firstVisitAt    DateTime @default(now())
  lastVisitAt     DateTime @default(now())
  citizenshipStatus String @default("visitor")  // visitor | resident | citizen | leader
  metadataJson    String   @default("{}")

  @@unique([userId, worldId])
  @@index([userId])
}

model CompanionMessageRecord {
  id              String   @id @default(cuid())
  userId          String
  role            String   // user | companion
  content         String
  messageType     String   @default("chat")  // chat | suggestion | alert | insight
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ─── v0.45 Consumer Reality Layer — The YouTube Moment ─────────────────────

model PlayGraphRecord {
  id              String   @id @default(cuid())
  userId          String
  experienceId    String
  interaction     String   // liked | played | abandoned | mastered | shared | forked | watched | competed | saved | rated
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([experienceId])
  @@index([userId, interaction])
}

model SavedSparkRecord {
  id              String   @id @default(cuid())
  userId          String
  experienceId    String
  createdAt       DateTime @default(now())

  @@unique([userId, experienceId])
  @@index([userId])
}

model ChallengeRecord {
  id              String   @id @default(cuid())
  experienceId    String
  creatorId       String
  title           String
  description     String
  type            String   @default("score")  // score | speed | survival | creative | social
  rewardLiquid    Int      @default(0)  // micro-Liquid prize pool
  targetScore     Int?
  durationHours   Int      @default(24)
  participantsJson String  @default("[]")  // userIds
  entriesJson     String   @default("[]")  // [{userId, score, at}]
  status          String   @default("ACTIVE")  // ACTIVE | COMPLETED | CANCELLED
  startsAt        DateTime @default(now())
  endsAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([experienceId])
}

model LeaderboardEntryRecord {
  id              String   @id @default(cuid())
  experienceId    String
  userId          String
  displayName     String
  score           Int
  rank            Int?
  sessionId       String?
  achievedAt      DateTime @default(now())

  @@unique([experienceId, userId])
  @@index([experienceId, score])
}

model LiveSessionRecord {
  id              String   @id @default(cuid())
  experienceId    String
  experienceName  String
  userId          String
  displayName     String
  sessionId       String
  viewerCount     Int      @default(0)
  status          String   @default("LIVE")  // LIVE | ENDED
  peakViewers     Int      @default(0)
  startedAt       DateTime @default(now())
  endedAt         DateTime?
}

model CreatorChannelRecord {
  id              String   @id @default(cuid())
  creatorId       String   @unique
  channelName     String
  tagline         String?
  bannerUrl       String?
  totalViews      Int      @default(0)
  totalPlayTimeMs Int      @default(0)
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── v0.46 Social Universe — Retention & Reality Layer ─────────────────────

model CollectionRecord {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  isPublic        Boolean  @default(true)
  coverEmoji      String   @default("📁")
  itemsJson       String   @default("[]")  // array of experienceIds
  followerCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model ReplayRecord {
  id              String   @id @default(cuid())
  sessionId       String
  experienceId    String
  experienceName  String
  userId          String
  displayName     String
  score           Int
  durationMs      Int
  highlightType   String?  // comeback | world-record | upset | clutch | speedrun
  highlightLabel  String?  // "Impossible comeback" etc.
  isPublic        Boolean  @default(true)
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  eventLogJson    String   @default("[]")  // key events timeline
  createdAt       DateTime @default(now())

  @@index([experienceId])
  @@index([userId])
}

model PlayerChallengeRecord {
  id              String   @id @default(cuid())
  fromUserId      String
  toUserId        String?  // null = open challenge
  experienceId    String
  experienceName  String
  type            String   // beat-score | speedrun | survival | no-damage | high-score
  description     String
  fromScore       Int?
  targetScore     Int?
  rewardLiquid    Int      @default(0)
  status          String   @default("PENDING")  // PENDING | ACCEPTED | COMPLETED | DECLINED | EXPIRED
  winnerId        String?
  entriesJson     String   @default("[]")  // [{userId, score, at}]
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
  @@index([experienceId])
}

model NotificationRecord {
  id              String   @id @default(cuid())
  userId          String
  type            String   // follow | challenge | achievement | live | replay | comment | fork | evolution | reward
  title           String
  body            String
  icon            String   @default("🔔")
  targetType      String?  // experience | creator | challenge | replay | collection
  targetId        String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ─── v0.47 Identity Universe — Communities + Game Lifecycle + Creator Posts ─

model CommunitySpaceRecord {
  id              String   @id @default(cuid())
  experienceId    String   @unique
  experienceName  String
  creatorId       String
  memberCount     Int      @default(0)
  description     String   @default("")
  rules           String   @default("Be kind. Play hard. Create freely.")
  createdAt       DateTime @default(now())

  posts           CommunityPostRecord[]
  members         CommunityMemberRecord[]
}

model CommunityMemberRecord {
  id              String   @id @default(cuid())
  communityId     String
  userId          String
  displayName     String
  role            String   @default("member")  // member | moderator | admin
  joinedAt        DateTime @default(now())

  community       CommunitySpaceRecord @relation(fields: [communityId], references: [id])
  @@unique([communityId, userId])
}

model CommunityPostRecord {
  id              String   @id @default(cuid())
  communityId     String
  userId          String
  displayName     String
  type            String   @default("discussion")  // discussion | strategy | build | challenge | poll | announcement
  title           String
  body            String
  upvotes         Int      @default(0)
  commentCount    Int      @default(0)
  pinned          Boolean  @default(false)
  pollOptionsJson String   @default("[]")  // for polls: [{option, votes}]
  createdAt       DateTime @default(now())

  community       CommunitySpaceRecord @relation(fields: [communityId], references: [id])
  @@index([communityId])
}

model GameLifecycleEventRecord {
  id              String   @id @default(cuid())
  experienceId    String
  experienceName  String
  milestone       String   // created | first-play | 100-players | 1k-players | first-fork | evolved | tournament | legendary | viral | community-formed
  title           String
  description     String
  icon            String   @default("🎮")
  metadataJson    String   @default("{}")
  achievedAt      DateTime @default(now())

  @@index([experienceId])
}

model CreatorPostRecord {
  id              String   @id @default(cuid())
  creatorId       String
  creatorName     String
  type            String   @default("update")  // update | announcement | devlog | behind-the-scenes | question | poll
  title           String
  body            String
  mediaUrl        String?
  pinned          Boolean  @default(false)
  likeCount       Int      @default(0)
  commentCount    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([creatorId])
}

// ─── v0.48 Creator Intelligence Universe ───────────────────────────────────

model CreatorInsightRecord {
  id              String   @id @default(cuid())
  creatorId       String
  experienceId    String?
  agentType       String   // designer | economy | balance | community | growth | narrative
  insightType     String   // observation | suggestion | alert | opportunity | prediction
  title           String
  body            String
  actionSuggestion String?
  expectedImpact  String?
  severity        String   @default("info")  // info | suggestion | warning | critical
  status          String   @default("PENDING")  // PENDING | ACCEPTED | DISMISSED | APPLIED
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([creatorId])
  @@index([agentType])
}

model CreatorExperimentRecord {
  id              String   @id @default(cuid())
  creatorId       String
  experienceId    String
  type            String   // ab-test | balance-change | new-feature | event-test
  hypothesis      String
  variantLabel    String   // "A" | "B" | "Variant 1"
  configJson      String   @default("{}")
  status          String   @default("DRAFT")  // DRAFT | RUNNING | COMPLETED | CANCELLED
  resultsJson     String   @default("{}")
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([creatorId])
  @@index([experienceId])
}

model GameEvolutionPlanRecord {
  id              String   @id @default(cuid())
  experienceId    String
  experienceName  String
  creatorId       String
  currentStage    String   @default("birth")  // birth | growth | optimization | expansion | civilization
  proposedStage   String?
  stepsJson       String   @default("[]")  // [{step, description, status, projectedImpact}]
  projectedRetention Float @default(0)
  projectedRevenue  Float  @default(0)
  status          String   @default("DRAFT")  // DRAFT | APPROVED | IN_PROGRESS | COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([experienceId])
}

model CreatorMarketplaceItemRecord {
  id              String   @id @default(cuid())
  creatorId       String
  creatorName     String
  type            String   // extension | mechanic | template | npc | world | asset-pack | ai-agent
  name            String
  description     String
  icon            String   @default("📦")
  priceRoyaltyBps Int      @default(500)  // basis points (500 = 5%)
  usedByCount     Int      @default(0)
  rating          Float    @default(5.0)
  revenueImpact   Float    @default(0)  // projected % revenue increase
  tagsJson        String   @default("[]")
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([creatorId])
  @@index([type])
}
